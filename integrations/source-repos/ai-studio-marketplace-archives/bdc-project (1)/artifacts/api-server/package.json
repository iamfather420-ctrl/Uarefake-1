{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node ./build.mjs && node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:all": "npm run test:middleware && npm run test:pillars && npm run test:crawlers",
    "test:middleware": "vitest run src/middleware/ai-linkey.test.ts",
    "test:pillars": "vitest run src/pillars/consensus-grid.test.ts src/pillars/vault.test.ts",
    "test:crawlers": "vitest run src/crawlers/outreach.test.ts"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@types/express-session": "^1.19.0",
    "@workspace/api-zod": "*",
    "@workspace/db": "*",
    "@workspace/integrations-openai-ai-server": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "groq-sdk": "^1.3.0",
    "nanoid": "^5.1.15",
    "openid-client": "^6.8.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "25.9.4",
    "esbuild": "^0.25.0",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^3.0.0"
  }
}
